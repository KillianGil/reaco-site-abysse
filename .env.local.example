# Firebase Configuration
# Copie ce fichier en .env.local et remplace les valeurs par les tiennes
# Tu les trouves dans la console Firebase > Paramètres du projet > Vos applications

NEXT_PUBLIC_FIREBASE_API_KEY=ta-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ton-projet.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ton-projet-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ton-projet.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef123456
